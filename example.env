# Channel whose chat is read (anonymously, no token needed).
TWITCH_CHANNEL=

# Chat command viewers use.
WHIP_COMMAND=!whip
# Whips per viewer per minute.
WHIP_RATE_LIMIT=3
# Minimum interval between messages typed into Claude Code.
# Whips during the cooldown still count and play on the overlay.
WHIP_COOLDOWN=15s
# Press Escape (interrupt the current turn) before typing the message.
WHIP_INTERRUPT=true

HTTP_ADDR=127.0.0.1:8080
